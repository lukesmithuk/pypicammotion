[Unit]
Description=pypicammotion — motion-detection video recording
After=network.target

[Service]
Type=simple
ExecStart=/opt/pypicammotion/venv/bin/pypicammotion run --config /etc/pypicammotion/config.yaml
User=%i
Group=video
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
